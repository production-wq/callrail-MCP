# ─────────────────────────────────────────────────────────────
# CallRail MCP Server — Environment Variables
# Copy this file to .env for local development.
# Add each variable in your hosting platform (Vercel / Render).
# NEVER put real values in this file — it is committed to git.
# ─────────────────────────────────────────────────────────────

# 1. Your CallRail API key (from CallRail → Settings → API)
CALLRAIL_API_KEY=your-callrail-api-key

# 2. Simple bearer token — used by Claude & Perplexity
MCP_API_KEY=a-long-random-string

# ── OAuth 2.0 (for ChatGPT) ───────────────────────────────────
# OAuth is enabled only when JWT_SECRET, OAUTH_USERNAME and OAUTH_PASSWORD are all set.

# 3. Secret used to sign every OAuth code/token/client. REQUIRED. 32+ random chars.
#    Changing it signs everyone out and invalidates registered ChatGPT clients.
JWT_SECRET=replace-with-a-long-random-secret-string

# 4. The login you type on the sign-in page ChatGPT opens
OAUTH_USERNAME=choose-a-username
OAUTH_PASSWORD=choose-a-strong-password

# 5. OPTIONAL — only if you paste a fixed Client ID/Secret into ChatGPT
#    ("user-defined OAuth client"). Leave blank to use automatic registration.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# 6. OPTIONAL — pin the public URL if you use a custom domain behind a proxy
#    e.g. https://callrail-mcp.vercel.app  (no trailing slash)
PUBLIC_BASE_URL=

# 7. OPTIONAL — extra exact redirect URIs to allow, comma separated
OAUTH_ALLOWED_REDIRECT_URIS=

# 8. Transport mode — "sse" on Render/Railway/local, leave blank on Vercel
TRANSPORT=sse
