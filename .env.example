# ─────────────────────────────────────────────────────────────
# CallRail MCP Server — Environment Variables
# Copy this file to .env for local development.
# Add each variable in your hosting platform (Vercel / Render).
# ─────────────────────────────────────────────────────────────

# 1. Your CallRail API key (from CallRail → Settings → API)
CALLRAIL_API_KEY=ctrk_1c1361ab30192bbd32d7f6fc89dd85ea321bcaea

# 2. Simple bearer token — used by Claude & Perplexity
MCP_API_KEY=my-FGH-hdcgsbs-hcdhhcGCsj-123F@U

# ── OAuth 2.0 (for ChatGPT) ───────────────────────────────────

# 3. OAuth Client ID — paste this into ChatGPT when it asks
OAUTH_CLIENT_ID=callrail-mcp-client

# 4. OAuth Client Secret — paste this into ChatGPT when it asks
OAUTH_CLIENT_SECRET=callrail-mcp-secret-change-me

# 5. Login username shown on the OAuth sign-in page
OAUTH_USERNAME=admin

# 6. Login password shown on the OAuth sign-in page
OAUTH_PASSWORD=CallRail2024!

# 7. Secret used to sign JWT access tokens — keep private, any long random string
JWT_SECRET=replace-with-a-long-random-secret-string-64-chars-is-ideal

# 8. Transport mode — always "sse" on Render/Railway, leave blank for Vercel
TRANSPORT=sse
